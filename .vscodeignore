# Everything the extension host does not need at runtime. `dist/` is bundled by
# esbuild, so the sources and the test bundle stay out of the package.
.vscode/**
.github/**
.gitignore
.vscodeignore
src/**
dist-test/**
esbuild.mjs
esbuild.test.mjs
tsconfig.json
package-lock.json
*.vsix
# The icon source. `images/icon.png` is what the manifest names and what the
# Extensions list draws; vsce refuses an SVG in the `icon` field outright.
images/**/*.svg
# The publishing runbook is addressed to whoever maintains the extension, not
# to whoever installs it. `docs/adr/` is deliberately left in, as it always was.
docs/publishing.md
